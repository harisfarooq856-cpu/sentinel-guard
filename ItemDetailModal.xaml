<Window x:Class="SentinelGuard.ItemDetailModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Inspection Report" Height="530" Width="670"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI, Arial">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
            <DockPanel>
                <Border x:Name="BadgeBorder" DockPanel.Dock="Right" CornerRadius="16" Padding="16,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtRiskBadge" Text="INFO" FontWeight="Bold" FontSize="13"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtHeaderName" Text="ProcessName.exe" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtHeaderPid" Text="(PID 1234)" Foreground="#94A3B8" FontSize="13" Margin="8,4,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubTitle" Text="Deep Security &amp; Heuristic Audit" Foreground="#38BDF8" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- BODY DETAILS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Fields Card -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Parent -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Spawned By:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4"/>
                        <TextBlock x:Name="TxtParent" Grid.Row="0" Grid.Column="1" Text="System" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,4" TextWrapping="Wrap"/>

                        <!-- Row 1: User -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="User Account:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4"/>
                        <TextBlock x:Name="TxtUser" Grid.Row="1" Grid.Column="1" Text="seoin" Foreground="#0F172A" Margin="0,4"/>

                        <!-- Row 2: Publisher / Signature -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Vendor / Signer:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4"/>
                        <TextBlock x:Name="TxtSigner" Grid.Row="2" Grid.Column="1" Text="Verified Software Vendor" Foreground="#059669" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap"/>

                        <!-- Row 3: Executable Path -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Binary Path:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4"/>
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                            <Button x:Name="BtnOpenFolder" Click="BtnOpenFolder_Click" Content="📂" DockPanel.Dock="Right" Width="28" Height="22" ToolTip="Open Folder" Background="#F1F5F9" BorderThickness="0" Margin="6,0,0,0"/>
                            <TextBlock x:Name="TxtPath" Text="C:\\..." Foreground="#0F172A" TextWrapping="Wrap"/>
                        </DockPanel>

                        <!-- Row 4: Network Endpoint -->
                        <TextBlock x:Name="LblNetwork" Grid.Row="4" Grid.Column="0" Text="Network Socket:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4"/>
                        <TextBlock x:Name="TxtNetwork" Grid.Row="4" Grid.Column="1" Text="-" Foreground="#0F172A" Margin="0,4"/>
                    </Grid>
                </Border>

                <!-- Reasons & Explanation Card -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="🛡️ Security Analysis &amp; Why This Risk Rating Was Given:" FontWeight="Bold" Foreground="#0F172A" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtExplanation" Text="-" Foreground="#334155" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ACTIONS FOOTER -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="BtnClose" Click="BtnClose_Click" Content="Close" DockPanel.Dock="Right" Height="34" Padding="16,0" Background="#F1F5F9" Foreground="#475569" BorderThickness="0"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnMarkSafe" Click="BtnMarkSafe_Click" Content="🛡 Mark as Safe" Background="#059669" Foreground="White" Height="34" Padding="14,0" BorderThickness="0" Margin="0,0,8,0"/>
                <Button x:Name="BtnTrustParent" Click="BtnTrustParent_Click" Content="🤖 Trust Parent" Background="#2563EB" Foreground="White" Height="34" Padding="14,0" BorderThickness="0" Margin="0,0,8,0"/>
                <Button x:Name="BtnTerminate" Click="BtnTerminate_Click" Content="🚫 Terminate" Background="#DC2626" Foreground="White" Height="34" Padding="14,0" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
